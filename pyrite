#!/usr/bin/env python3
"""
Pyrite CLI - Unified command-line interface for Pyrite toolkit

Usage:
    pyrite <command> [options]

Commands:
    lint        Run Obsidian markdown linter
    health      Check GitHub integration health
    structure   Verify repository structure
    ticket      Create, list and re-status tickets in work efforts
    we          Create a work effort from a list of todos
    daily-note  Sync work efforts to Obsidian daily note

Examples:
    pyrite lint --scope _work_efforts --fix
    pyrite health
    pyrite structure --fix
    pyrite we create --title "Ship checkout" --todo "Wire webhook"
    pyrite daily-note --dry-run
    pyrite --version
"""

import sys
import argparse
import subprocess
from pathlib import Path


__version__ = "0.7.0"


def get_repo_root():
    """Get the repository root directory."""
    # Script is in repo root
    return Path(__file__).parent.resolve()


def run_tool(script_path, args):
    """Run a tool script with the given arguments."""
    cmd = [sys.executable, str(script_path)] + args
    result = subprocess.run(cmd)
    return result.returncode


def cmd_lint(args):
    """Run the Obsidian markdown linter."""
    repo_root = get_repo_root()
    script = repo_root / "tools" / "obsidian-linter" / "lint.py"
    return run_tool(script, args)


def cmd_health(args):
    """Run the GitHub health check."""
    repo_root = get_repo_root()
    script = repo_root / "tools" / "github-health-check" / "check.py"
    return run_tool(script, args)


def cmd_structure(args):
    """Run the structure check."""
    repo_root = get_repo_root()
    script = repo_root / "tools" / "structure-check" / "check.py"
    return run_tool(script, args)


def cmd_ticket(args):
    """Run the ticket tool (create, list, status)."""
    repo_root = get_repo_root()
    script = repo_root / "tools" / "ticket" / "create.py"
    return run_tool(script, args)


def cmd_we(args):
    """Run the work effort tool (create, list)."""
    repo_root = get_repo_root()
    script = repo_root / "tools" / "work-effort" / "create.py"
    return run_tool(script, args)


def cmd_daily_note(args):
    """Sync work efforts to today's daily note."""
    # Lazy import so the plugin is only loaded when needed
    plugin_dir = str(get_repo_root())
    if plugin_dir not in sys.path:
        sys.path.insert(0, plugin_dir)
    from plugins.daily_note.plugin import DailyNoteBridge

    config = {
        "work_efforts_dir": str(get_repo_root() / "_work_efforts"),
        "simpleagentos_dir": "/Users/ctavolazzi/Code/_experiments/SimpleAgentOS",
    }

    dry_run = "--dry-run" in args
    if "--no-git-health" in args:
        config["include_git_health"] = False

    # Extract --date value if provided
    date = None
    if "--date" in args:
        idx = args.index("--date")
        if idx + 1 < len(args):
            date = args[idx + 1]

    bridge = DailyNoteBridge(config)
    full = "--full" in args

    if full:
        result = bridge.full_sync(date=date, dry_run=dry_run)
        if dry_run:
            for section, data in result.items():
                if isinstance(data, dict):
                    print(f"--- {section} ---")
                    print(data.get("content", data.get("fields", data)))
                    print()
                else:
                    print(f"--- {section}: {data} ---")
            print("-- dry run, nothing written --")
        else:
            for section, data in result.items():
                if isinstance(data, dict):
                    print(f"  {section}: {data.get('status', '?')}")
                else:
                    print(f"  {section}: {data}")
            print("Full daily note sync complete.")
    else:
        result = bridge.sync(date=date, dry_run=dry_run)
        if dry_run:
            print(result["content"])
            print("\n-- dry run, nothing written --")
        else:
            print(f"Daily note synced: {result['status']} ({result['section']})")

    # Status check
    if "--status" in args:
        status = bridge.get_section_status(date)
        print("\nSection status:")
        for section, state in status.items():
            print(f"  {section}: {state}")

    # Yesterday's handoff
    if "--handoff" in args:
        import json
        handoff = bridge.read_yesterday_handoff()
        print("\nYesterday's handoff:")
        print(json.dumps(handoff, indent=2))

    # Ensure tomorrow's note exists
    if "--ensure-tomorrow" in args:
        result = bridge.ensure_tomorrow()
        print(f"\nTomorrow's note: {result['status']}")
        if "path" in result:
            print(f"  Created: {result['path']}")

    return 0


def main():
    parser = argparse.ArgumentParser(
        prog='pyrite',
        description='Pyrite - AI-powered repository management toolkit',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Commands:
  lint        Run Obsidian markdown linter
  health      Check GitHub integration health
  structure   Verify repository structure
  ticket      Create, list and re-status tickets in work efforts
  we          Create a work effort from a list of todos
  daily-note  Sync work efforts to Obsidian daily note

Examples:
  pyrite lint --scope _work_efforts --fix
  pyrite health
  pyrite structure --fix
  pyrite ticket create --we WE-260127-abcd --title "Fix bug"
  pyrite we create --title "Ship checkout" --todos-file todos.md
  pyrite we list --filter-status active
  pyrite daily-note --dry-run
  pyrite --version

For command-specific help:
  pyrite <command> --help
        """
    )

    parser.add_argument(
        '--version',
        action='version',
        version=f'%(prog)s {__version__}'
    )

    # Use subparsers for commands
    subparsers = parser.add_subparsers(dest='command', help='Command to run')

    # Lint command
    lint_parser = subparsers.add_parser(
        'lint',
        help='Run Obsidian markdown linter',
        add_help=False  # Let the underlying tool handle --help
    )

    # Health command
    health_parser = subparsers.add_parser(
        'health',
        help='Check GitHub integration health',
        add_help=False
    )

    # Structure command
    structure_parser = subparsers.add_parser(
        'structure',
        help='Verify repository structure',
        add_help=False
    )

    ticket_parser = subparsers.add_parser(
        'ticket',
        help='Create tickets in work efforts',
        add_help=False
    )

    we_parser = subparsers.add_parser(
        'we',
        help='Create a work effort from a list of todos',
        add_help=False
    )

    # Daily note command
    daily_note_parser = subparsers.add_parser(
        'daily-note',
        help='Sync work efforts to daily note',
        add_help=False
    )

    # Parse known args to allow forwarding unknowns to subcommands
    args, unknown = parser.parse_known_args()

    # If no command specified, show help
    if not args.command:
        parser.print_help()
        return 0

    # Route to appropriate command handler
    handlers = {
        'lint': cmd_lint,
        'health': cmd_health,
        'structure': cmd_structure,
        'ticket': cmd_ticket,
        'we': cmd_we,
        'daily-note': cmd_daily_note,
    }

    handler = handlers.get(args.command)
    if handler:
        return handler(unknown)
    else:
        print(f"Unknown command: {args.command}", file=sys.stderr)
        parser.print_help()
        return 1


if __name__ == '__main__':
    sys.exit(main())
